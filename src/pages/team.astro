---
import BaseLayout from "../layouts/BaseLayout.astro";
import Wolfy from "../content/team/wolfy.astro";
import Anzeal from "../content/team/anzeal.astro";
import Fire from "../content/team/fire.astro";
import Admiral from "../content/team/admiral.astro";
import Lokt from "../content/team/lokt.astro";
import Lukas from "../content/team/lukas.astro";
import Riko from "../content/team/riko.astro";
import Mak from "../content/team/mak.astro";
import  '../styles/team.css'
---

<BaseLayout>
  <header class="story">
    <h1>The Team</h1>
    <p>
      We are Team Filtered, a group of Neuro fans and other artists, that formed
      to bring the idea of this game to life.
    </p>
  </header>
  <section>
    <h3>Meet the Team leaders</h3>
    <div class="characters">
        <Wolfy />
        <Anzeal />
        <Fire />
        <Admiral />
        <Lokt />
        <Lukas />
    </div>
  </section>
  <section>
    <h3>Meet the Art Department</h3>
    <div class="characters">
      <Riko />
      <Mak />

      <div class="card">
        <header class="card-header">
            <img src="img/the_team/Ollie.png" />
          <div class="card-titles">
            <h3>Ollie</h3>
            <p>Artist</p>
          </div>
        </header>
        <div class="bio-panel">
            <div class="bio-inner"></div>
            <p class="tc-loading">No bio available</p>
        </div>
      </div>
      <div class="card">
        <header class="card-header">
            <img src="img/the_team/EJ.webp" />
          <div class="card-titles">
            <h3>EJ</h3>
            <p>Artist</p>
          </div>
        </header>
        <div class="bio-panel">
            <div class="bio-inner"></div>
            <p >Hello everybody my name is not markiplier.</p>
        </div>
      </div>
      <div class="card">
        <header class="card-header">
            <img src="img/the_team/G_pfp.jpg" />
          <div class="card-titles">
            <h3>G</h3>
            <p>Artist</p>
          </div>
        </header>
        <div class="bio-panel">
            <div class="bio-inner"></div>
            <p class="tc-loading">No bio available</p>
        </div>
      </div>
    </div>
  </section>
  <section>
    <h3>Meet the Audio/Music Department</h3>
    <div class="characters">
      <div class="card" data-bio="/members/bora.html">
        <img src="img/the_team/bora.jpg" />

        <h3>Bora</h3>
        <p>Musician</p>
      </div>
      <div class="card" data-bio="/members/nathan.html">
        <img src="img/the_team/nathan.png" />

        <h3>Nathan</h3>
        <p>Musician</p>
      </div>
      <div class="card" data-bio="/members/chxi.html">
        <img src="img/the_team/chxi.jpg" />

        <h3>CHXI</h3>
        <p>Musician</p>
      </div>
    </div>
  </section>
  <section>
    <h3>Meet the writing Department</h3>
    <div class="characters">
      <div class="card" data-bio="/members/skele.html">
        <img src="img/the_team/Skele.png" />

        <h3>SkeledirgeT-Rex</h3>
        <p>Assistant Writing Head and Nere Expert</p>
      </div>
      <div class="card" data-bio="/members/wedal.html">
        <img src="img/the_team/Wedal.png" />

        <h3>Wedal987</h3>
        <p>Assistant Writing Head</p>
      </div>

      <div class="card" data-bio="">
        <img src="img/the_team/onyx.png" />

        <h3>Onyx</h3>
        <p>Writer</p>
      </div>
    </div>
  </section>
  <section>
    <h3>Meet the Programming Department and the Game Design Department</h3>
    <div class="characters">
      <div class="card" data-bio="/members/ktrain.html">
        <img src="img/the_team/KTrain.png" />

        <h3>KTrain</h3>
        <p>Website maintainer, tooling "maintainer", and game dev</p>
      </div>

      <div class="card" data-bio="/members/komi.html">
        <img src="img/the_team/Komi.png" />

        <h3>Komikron</h3>
        <p>Senior Developer and Game Designer</p>
      </div>
    </div>
  </section>
</BaseLayout>
