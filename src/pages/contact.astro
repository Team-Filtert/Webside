---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout styles={['../styles/contact.css']}>
  <section class="contact">
    <h2>Where you can find us</h2>
    <div class="contact-info">
      <div class="Youtube-links">
        <h3>
          <img src="assets/logos/youtube.svg" alt="YouTube logo" />
          <span>YouTube</span>
        </h3>

        <a href="https://www.youtube.com/@CountWolfy" target="_blank"
          >Count Wolfy</a
        >
        <a href="https://youtube.com/@LukasDerBaum" target="_blank"
          >Lukas DerBaum</a
        >
        <a href="https://www.youtube.com/@RikoTanaki127" target="_blank">Riko</a
        >
      </div>
      <div class="Twitter-links" class="links">
        <h3>
          <img src="assets/logos/twitter.svg" alt="Twitter logo" />
          <span>Twitter</span>
        </h3>

        <a href="https://x.com/@Teamfilteredf" target="_blank">Team Filtered</a>
        <a href="https://x.com/CountWolfy" target="_blank">CountWolfy</a>
        <a href="https://x.com/@DerbaumLuk37729" target="_blank"
          >Lukas DerBaum</a
        >
        <a href="https://x.com/RikoTanaki127" target="_blank">Riko</a>
      </div>
      <div class="discord-links">
        <h3>
          <img src="assets/logos/discord-svgrepo-com.svg" alt="Discord logo" />
          <span>Discord</span>
        </h3>

        <a href="https://discord.gg/85XPEAyQ" target="_blank"
          >Our Discord server</a
        >
      </div>
      <div class="github-links">
        <h3>
          <img
            src="assets/logos/github-142-svgrepo-com.svg"
            alt="GitHub logo"
          />
          <span>GitHub</span>
        </h3>

        <a href="https://github.com/Team-Filtert" target="_blank"
          >Our GitHub Org</a
        >
        <a href="https://github.com/Team-Filtert/Webside" target="_blank"
          >This Website</a
        >
      </div>
      <div>
        <h3>
          <img src="assets/logos/email.svg" alt="Email logo" />
          <span>Email</span>
        </h3>

        <p>teamfilteredo7@gmail.com</p>
      </div>
    </div>
  </section>
</BaseLayout>
