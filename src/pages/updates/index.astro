---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getCollection('updates', ({ data }) => {
  return import.meta.env.PROD ? data.published.draft !== true : true;
})
---

<BaseLayout>
  <header class="updates">
    <div class="inner">
      <h1 class="update-h">Updates</h1>
      <p class="tagline">Here you can find all our devlogs</p>
      <span class="post-count">0 Devlogs</span>
    </div>
  </header>

  <main>
    <h2 class="update-h">Latest</h2>
    <div id="posts-container-latest"></div>
    <h2 class="update-h">Other</h2>
    <div id="posts-container"></div>
  </main>
  <script src="../../scripts/updates.ts"></script>
</BaseLayout>
