---
import BaseLayout from "../layouts/BaseLayout.astro";
import UpdateCard from "../components/UpdateCard.astro";

import '../styles/updates.css'

import { getCollection } from "astro:content";


const posts = await getCollection('updates', ({ data }) => {
  return import.meta.env.PROD ? data.published !== 'draft' : true;
})
const publishedPosts = posts.filter((p) => p.data.published !== 'draft');
publishedPosts.sort((a, b) => (b.data.published as Date).valueOf() - (a.data.published as Date).valueOf());
const latestPost = publishedPosts[0];
---

<BaseLayout>
  <header class="hero" id="hero">
    <img class="logo" src="img/NGEF_logo.png" />

    <h1>Neuro-sama: The Good, The Evil And The Filtered</h1>

    <p id="typing"></p>

    <div class="link-btns">
      <a href="/updates">
        <div class="btn">
          <span>Patch Notes</span>
        </div>
      </a>

      <a href="https://discord.gg/nAXzxMY9gT" target="_blank">
        <div class="btn">
          <span
            >Discord <img
              class="link-logo"
              src="assets/logos/discord-svgrepo-com.svg"
            /></span
          >
        </div>
      </a>

      <a href="/contact">
        <div class="btn">
          <span>Contact us</span>
        </div>
      </a>
    </div>
  </header>

  <section id="about">
    <h2><a href="/about">About the game</a></h2>
    <p>
      Neuro-sama: The Good, The Evil, And The Filtered is a JRPG in which Neuro
      and Evil are sent on an adventure through seven different worlds. Along
      the way, they'll meet many friends, some of whom will help them on their
      journey, while others, corrupted by the filter, will stand in their way
      and have to be brought back to normal.
    </p>
    <br />
    <a href="/about" class="other_page">Learn more...</a>
  </section>


  <section id="team">
    <h2><a href="./team">The Team</a></h2>
    <p>
      We are Team Filtered, a group of Neuro fan and other artists, that formed
      to bring the idea of this game to life.
    </p>
    <h3>Meet the Team leaders</h3>
    <div class="characters">
        
        <a href="/team#CountWolfy" class="b_card">
        <img src="img/the_team/Wolfy.png" />
        <h3>Wolfy</h3>
        <p>Creative Director</p>
        </a>

      <a href="/team#Anzeal" class="b_card">
        <img src="img/the_team/Anzeal.jpg" />
        <h3>Anzeal</h3>
        <p>Head of the Art, Marketing, and Translation Departments</p>
      </a>

      <a href="/team#Firearchers" class="b_card">
        <img src="img/the_team/Firearchers.png" />
        <h3>Firearchers</h3>
        <p>Head of the Writing Department</p>
      </a>

      <a href="/team#AdmiralEnsin" class="b_card">
        <img src="img/the_team/AdmiralEnsin.png" />
        <h3>AdmiralEnsin</h3>
        <p>Head of the Audio and Recruitment Department</p>
      </a>

      <a href="/team#Komikron" class="b_card">
        <img src="img/the_team/Komi.png" />
        <h3>Komikron</h3>
        <p>Lead Developer</p>
      </a>

      <a href="/team#LukasDerBaum" class="b_card">
        <img src="img/the_team/LukasDerBaum.svg" />
        <h3>Lukas</h3>
        <p>Lead Game Designer</p>
      </a>
    </div>
    <br />
    <a href="./team.html" class="other_page">Meet the entire team!</a>
  </section>
  <section id="posters">
    <h2>Posters</h2>

    <div class="gallery">
      <div class="gallery-item">
        <img src="/img/NGEF_Poster.png" />
        <p>by Anzeal</p>
      </div>
      <div class="gallery-item">
        <img src="/img/NGEF_Mini_Poster.jpg" />
        <p>by Ollie</p>
      </div>
      <div class="gallery-item">
        <img src="/img/NGEF_Nere_Poster.png" />
        <p>by Anzeal</p>
      </div>
      <div class="gallery-item">
        <img src="/img/Evil_Poster.jpg" />
        <p>by Ollie</p>
      </div>
      <div class="gallery-item">
        <img src="/img/ellie_poster.png" />
        <p>by Viann</p>
      </div>
    </div>
  </section>

  <section id="updates">
    <h2><a href="/updates">Dev logs</a></h2>
    <p>
      We are going to regualy/semi regualy make dev log or whenever there is a
      big update.
    </p>
    <h2>Latest Update</h2>
    <div class="patch">
        <UpdateCard id={latestPost.id} title={latestPost.data.title} date={latestPost.data.published} summary={latestPost.data.summary} author={latestPost.data.author} />
    </div>
    <br />
    <a href="/updates" class="other_page">See other posts</a>
  </section>
  <!-- <script src="../scripts/updates.ts"></script> -->
</BaseLayout>
