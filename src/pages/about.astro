---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <header class="story">
    <h1>About the game</h1>
    <p>
      Neuro-sama: The Good, The Evil And The Filtered is a JRPG, in which Neuro
      and Evil are sent on an adventure through 7 different worlds. Along the
      way, they'll meet many friends, some of whom will help them on their
      journey, but others, corrupted by the filter, will stand in their way and
      have to be brought back to normal.
    </p>
  </header>
</BaseLayout>
