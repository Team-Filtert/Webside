---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TeamMemberCard from "../../components/TeamMemberCard.astro";
import { getCollection, getEntries, render } from "astro:content";

const heads = await getCollection("departments").then(async (h) => {
  const headObjects = h.map((m) => m.data.head);
  const memberData = await getEntries(headObjects);
  return memberData;
});

// Render bio content for each head
const headsWithBios = await Promise.all(
  heads.map(async (h) => {
    const rendered = await render(h);
    return {
      data: h.data,
      rendered: rendered,
    };
  }),
);

const headIDs = heads.map((h) => h.id);
---

<BaseLayout>
  <header class="story">
    <h1>The Team</h1>
    <p>
      We are Team Filtered, a group of Neuro fan and other artists, that formed
      to bring the idea of this game to life.
    </p>
  </header>
  <section>
    <h3>Meet the Team leaders</h3>
    <div class="characters">
      {
        headsWithBios.map((h) => {
          return <TeamMemberCard
            name={h.data.name}
            description={h.data.description}
            img={h.data.image}
          >
            <h.rendered.Content />
          </TeamMemberCard>
        })
      }
    </div>
  </section>
  <section>
    <h3>Meet the Art Department</h3>
    <div class="characters">
      <div class="card" data-bio="/members/riko.html">
        <img src="/img/the_team/Riko.png" />

        <h3>Riko</h3>
        <p>Vice Head of the Art Department</p>
      </div>

      <div class="card" data-bio="/members/mak.html">
        <img src="/img/the_team/Mak-Blast.png" />

        <h3>Mak-Blast</h3>
        <p>Artist</p>
      </div>

      <div class="card">
        <img src="/img/the_team/Ollie.png" />

        <h3>Ollie</h3>
        <p>Artist</p>
      </div>
      <div class="card" data-bio="/members/EJ.html">
        <img src="/img/the_team/EJ.webp" />

        <h3>EJ</h3>
        <p>Artist</p>
      </div>
      <div class="card">
        <img src="/img/the_team/G_pfp.jpg" />

        <h3>G</h3>
        <p>Artist</p>
      </div>
    </div>
  </section>
  <section>
    <h3>Meet the Audio/Music Department</h3>
    <div class="characters">
      <div class="card" data-bio="/members/bora.html">
        <img src="/img/the_team/bora.jpg" />

        <h3>Bora</h3>
        <p>Musician</p>
      </div>
      <div class="card" data-bio="/members/nathan.html">
        <img src="/img/the_team/nathan.png" />

        <h3>Nathan</h3>
        <p>Musician</p>
      </div>
      <div class="card" data-bio="/members/chxi.html">
        <img src="/img/the_team/chxi.jpg" />

        <h3>CHXI</h3>
        <p>Musician</p>
      </div>
    </div>
  </section>
  <section>
    <h3>Meet the writing Department</h3>
    <div class="characters">
      <div class="card" data-bio="/members/skele.html">
        <img src="/img/the_team/Skele.png" />

        <h3>SkeledirgeT-Rex</h3>
        <p>Assistant Writing Head and Nere Expert</p>
      </div>
      <div class="card" data-bio="/members/wedal.html">
        <img src="/img/the_team/Wedal.png" />

        <h3>Wedal987</h3>
        <p>Assistant Writing Head</p>
      </div>

