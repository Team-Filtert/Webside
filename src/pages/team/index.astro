---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TeamMemberCard from "../../components/TeamMemberCard.astro";
import { getCollection, getEntry, render } from "astro:content";

const departments = await getCollection("departments");
const the_team = await getCollection("members");

let heads = [];
let musicians = [];
let game_desingers = [];
let artists = [];
let writers = [];
let programmers = [];
let translators = [];

for (const d of departments) {
  if (!d.data.head) continue;
  const head_obj = d.data.head;
  const head_data = await getEntry(head_obj);
  heads.push(head_data);
}

for (const m of the_team) {
  // if (!m.data.departments) continue;
  if (m.data.departments.includes("music")) musicians.push(m);
  if (m.data.departments.includes("game-design")) game_desingers.push(m);
  if (m.data.departments.includes("art")) artists.push(m);
  if (m.data.departments.includes("writing")) writers.push(m);
  if (m.data.departments.includes("programming")) programmers.push(m);
  if (m.data.departments.includes("translation")) translators.push(m);
}




function getBios(members: any) {
  return Promise.all(
    members.map(async (h: any) => {
      const rendered = await render(h);
      return {
        data: h.data,
        rendered: rendered,
      };
    }),
  );
}


// Render bio content for each head
const headsWithBios = await getBios(heads);

const musiciansWithBios = await getBios(musicians);
const game_desingersWithBios = await getBios(game_desingers);
const artistsWithBios = await getBios(artists);
const writersWithBios = await getBios(writers);
const programmersWithBios = await getBios(programmers);
const translatorsWithBios = await getBios(translators);

---

<BaseLayout>
  <header class="story">
    <h1>The Team</h1>
    <p>
      We are Team Filtered, a group of Neuro fan and other artists, that formed
      to bring the idea of this game to life.
    </p>
    <p>
        Here you can learn more about the team and their roles.
        <br />
        They are sorted by departments but not necessarily by role.
    </p>
  </header>
  <section>
    <h2>Meet the Team leaders</h2>
    <div class="characters">
      {
        headsWithBios.map((h) => {
          return <TeamMemberCard
            name={h.data.name}
            description={h.data.description}
            img={h.data.image}
          >
            <h.rendered.Content />
          </TeamMemberCard>
        })
      }
    </div>
  </section>
  <section>
    <h2>Meet the Art Department</h2>
    <div class="characters">
        {
          artistsWithBios.map((h) => {
            return <TeamMemberCard
              name={h.data.name}
              description={h.data.description}
              img={h.data.image}
            >
              <h.rendered.Content />
            </TeamMemberCard>
          })
        }
    </div>
  </section>
  <section>
    <h2>Meet the Audio/Music Department</h2>
    <div class="characters">
        {
          musiciansWithBios.map((h) => {
            return <TeamMemberCard
              name={h.data.name}
              description={h.data.description}
              img={h.data.image}
            >
              <h.rendered.Content />
            </TeamMemberCard>
          })
        }
    </div>
  </section>
  <section>
    <h2>Meet the Writing Department</h2>
    <div class="characters">
        {
          writersWithBios.map((h) => {
            return <TeamMemberCard
              name={h.data.name}
              description={h.data.description}
              img={h.data.image}
            >
              <h.rendered.Content />
            </TeamMemberCard>
          })
        }
    </div>
  </section>
  <section>
    <h2>Meet the Game Design Department</h2>
    <div class="characters">
        {
          game_desingersWithBios.map((h) => {
            return <TeamMemberCard
              name={h.data.name}
              description={h.data.description}
              img={h.data.image}
            >
              <h.rendered.Content />
            </TeamMemberCard>
          })
        }
    </div>
  </section>
  <section>
    <h2>Meet the Programming Department</h2>
    <div class="characters">
        {
          programmersWithBios.map((h) => {
            return <TeamMemberCard
              name={h.data.name}
              description={h.data.description}
              img={h.data.image}
            >
              <h.rendered.Content />
            </TeamMemberCard>
          })
        }
    </div>
  </section>
  <section>
    <h2>Meet the Translation Department</h2>
    <div class="characters">
        {
          translatorsWithBios.map((h) => {
            return <TeamMemberCard
              name={h.data.name}
              description={h.data.description}
              img={h.data.image}
              language={"Language: " + h.data.language}
            >
              <h.rendered.Content />
            </TeamMemberCard>
          })
        }
    </div>
  </section>
  <script src="../../scripts/team.ts" />
</BaseLayout>
