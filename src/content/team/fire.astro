---
import TeamCardLayout from "../../layouts/TeamCardLayout.astro";

---
<TeamCardLayout>
    <header class="card-header">
            <img src="img/the_team/Firearchers.png" />
            <div class="card-titles">
                <h3>Firearchers</h3>
                <p>Head of the Writing Department</p>
            </div>
    </header>
    <div class="bio-panel">
        <div class="bio-inner"></div>
        <p>
            hello my friends I'm just your average insane person that became a
            writer. If you need anything (that's not money) feel free to ping me
            anywhere whether on discord,
            <a href="https://x.com/FireArchers_" target="_blank">twitter</a> or
            through the email!
        </p>
    </div>
</TeamCardLayout>
