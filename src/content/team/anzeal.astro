---
import TeamCardLayout from "../../layouts/TeamCardLayout.astro";

---


<TeamCardLayout>
    <header class="card-header">
            <img src="img/the_team/Anzeal.jpg" />
            <div class="card-titles">
                <h3>Anzeal</h3>
                <p>Head of the Art, Marketing, and Translation Departments</p>
            </div>
    </header>
    <div class="bio-panel">
        <div class="bio-inner"></div>
        <p>
            Hi I'm Anzeal the Head of team filtered Art, Marketing and
            Translation department , I'm mainly here to make sure that artist
            stays organized and doing the work needed for the project while also
            making sure that they don't get overworked or stressed , I'm also an
            artist and I usually make promotional poster for the fan game.
        </p>
        <p>
            Outside of the project, I'm just a Neuroverse artist on
            <a href="https://x.com/Anzeal14" target="_blank">twitter</a> just
            like any other, I mainly draw Neuro, Evil and Chrchie and maybe some
            other Vtuber or even other artists when I feel like it. I also have
            comms open on
            <a href="https://vgen.co/Anzeal" target="_blank">Vgen</a>
        </p>
    </div>
</TeamCardLayout>
