---
import TeamCardLayout from "../../layouts/TeamCardLayout.astro";
---

<TeamCardLayout>
    <header class="card-header">
            <img src="img/the_team/LukasDerBaum.svg" />
            <div class="card-titles">
                <h3>Lukas DerBaum</h3>
                <p>Lead Game Designer</p>
            </div>
    </header>
    <div class="bio-panel">
        <div class="bio-inner"></div>
        <p>
            Hi, I'm Lukas DerBaum the lead game designer, here at team filtered.
            I'm also the one who made this website. My job is to turn Wolfy's
            ideas into actual game mechanics, making the game worlds come to
            life and making sure that the game is actually fun and engaging.
        </p>
        <p>
            Outside of team filtered, I've been working on my own game projects.
            One of my own projects is a game named Dice Dungeon, which is
            available on
            <a href="https://lukasderbaum42.itch.io/dice-dungeon" target="_blank">itch.io</a>.
        </p>
        <p>
            You can find me on
            <a href="https://youtube.com/@LukasDerBaum" target="_blank">Youtube</a> and
            <a href="https://x.com/@DerbaumLuk37729" target="_blank">Twitter</a>.
        </p>
    </div>
</TeamCardLayout>
