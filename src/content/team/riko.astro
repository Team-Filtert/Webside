---
import TeamCardLayout from "../../layouts/TeamCardLayout.astro";
---

<TeamCardLayout>
    <header class="card-header">
        <img src="img/the_team/Riko.png" />
        <div class="card-titles">
            <h3>Riko Tanaki</h3>
            <p>Vice Head of the Art Department</p>
        </div>
    </header>
    <div class="bio-panel">
        <div class="bio-inner"></div>
        <p>
            HI I'm Riko one of the artist and vice art head for the project. I'm just here to make stuff.
        </p>

        <p>
            You can see my other stuff on my socials like:
            <ul>
                <li><a href="https://www.youtube.com/@RikoTanaki127" target="_blank">Youtube</a></li>
                <li><a href="https://x.com/RikoTanaki127" target="_blank">Twitter</a></li>
                <li><a href="https://www.tumblr.com/rikotanaki127?source=share" target="_blank">Tumblr</a></li>
            </ul>
        </p>
    </div>
</TeamCardLayout>