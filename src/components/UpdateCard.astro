---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/updates.css"
import { getEntries } from "astro:content";

interface Props {
  id: any;
  title: string;
  date: Date | string;
  summary: string;
  author: any;
}

const { id, title, date, summary, author } = Astro.props;
---

    <article class="post-card">
        <a href={`/updates/${id}`} class="card-link">
            <div class="card-base">
                <div class="card-meta">
                    <div class="card-date-author">
                        <time class="card-time">{date == 'draft' ? 'Draft' : (date as Date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
                        by
                        <div class="card-author">{getEntries(author).then((a) => {
                            const authorNames: string[] = [];
                            for (const author of a) {
                                authorNames.push(author.data.name)
                            }
                            return authorNames;
                          }).then((a) => a.join(', '))}</div>
                    </div>
                    <h2 class="card-title">{title}</h2>
                    <p class="card-summary">{summary}</p>
                    <span class="card-cta">
                        Read Devlog <span class="card-arrow">→</span>
                    </span>
                </div>
            </div>
        </a>
    </article>
