---

interface Props {
    customClass: string;
    imgSrc?: string;
    id?: string;
}

const { customClass, imgSrc, id } = Astro.props;
---

<div class={customClass} id={id}>
    <!-- <div class="card-content"> -->
    <header class="card-header">
        {imgSrc ? <img src={imgSrc} /> : ''}
        <div class="card-titles">
            <h3><slot name="name" /></h3>
            <p><slot name="description" /></p>
            <p><slot name="language" /></p>
        </div>
    </header>

    <slot />
    <!-- </div> -->
</div>
