---
import MemberCard from "./common/MemberCard.astro";

interface Props {
  name: string;
  description: string;
  img?: string;
}

const { name, description, img } = Astro.props;
---

<MemberCard customClass="card tc-card" imgSrc={img}>
  <Fragment slot="name">{name}</Fragment>
  <Fragment slot="description">{description}</Fragment>
  <div class="bio">
    <slot />
  </div>
</MemberCard>
