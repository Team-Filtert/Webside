---
import MemberCard from './common/MemberCard.astro';

interface Props {
    name: string;
    description: string;
    img: string;
}

const { name, description, img } = Astro.props;
---

<MemberCard customClass="card" imgSrc={img}>
    <a slot="name">{name}</a>
    <a slot="description">{description}</a>
    <div class="bio"><slot /></div>
</MemberCard>
