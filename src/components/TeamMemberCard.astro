---
import MemberCard from "./common/MemberCard.astro";
import "../styles/cards.css";

interface Props {
    name: string;
    description: string;
    img?: string;
}

const { name, description, img } = Astro.props;
---

<MemberCard customClass="card" aria-expanded="false" imgSrc={img}>
    <Fragment slot="name">{name}</Fragment>
    <Fragment slot="description">{description}</Fragment>
    <div class="bio">
        <div class="bio-inner"></div>
        <slot />
    </div>
</MemberCard>
